---
// sidebar.php: back-to-top + search box. Single posts (single.php) show only the
// search box. The original timeline, blogroll and recent-comments widgets were
// dynamic and are not part of the archive.
import SearchForm from './SearchForm.astro';

interface Props {
	nachOben?: boolean;
}
const { nachOben = true } = Astro.props;
---

<div id="sidebar">
	{
		nachOben && (
			<p class="nachOben">
				<a href="#oben">zurück nach oben</a>
			</p>
		)
	}
	<div class="suche">
		<a id="suche"></a>
		<SearchForm />
	</div>
</div>

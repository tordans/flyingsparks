---
// One comment of the flat list (comments.php markup). Post-author comments get
// cByPostAuthor (orange), pingbacks cTypePingback (light blue).
import postAuthorComments from '../data/post-author-comments.json';
import { sanitizeComment } from '../lib/sanitize';
import type { WpComment } from '../lib/wpComments';
import { wpShortDate, wpTime } from '../lib/wpDate';

interface Props {
	comment: WpComment;
	odd: boolean;
}
const { comment, odd } = Astro.props;
const byAuthor = (postAuthorComments as string[]).includes(comment.id);
const type = { comment: 'Kommentar', pingback: 'Pingback', trackback: 'Trackback' }[comment.type] ?? 'Kommentar';
const date = comment.date ? new Date(comment.date) : undefined;
// comment_author_url_link(): URL without scheme, "www." and trailing slash.
const urlText = (comment.authorUrl ?? '')
	.replace(/^https?:\/\/(www\.)?/, '')
	.replace(/\/$/, '');
const linkAuthor = comment.type !== 'comment' && comment.authorUrl;
---

<li
	class={`cStyle${odd ? 'A' : 'B'} ${byAuthor ? 'cByPostAuthor' : 'cByGuest'} cType${type}`}
	id={`comment-${comment.id}`}
>
	<p>
		<cite>
			<span class="cAuthor" title="zur Homepage des Autors"
				>{
					linkAuthor ? (
						<a href={comment.authorUrl} class="url" rel="ugc external nofollow">{comment.author}</a>
					) : (
						comment.author
					)
				} ({
					comment.authorUrl && (
						<a href={comment.authorUrl} rel="ugc external nofollow">{urlText}</a>
					)
				})</span
			>{' '}
			{date && wpShortDate(date)}{' '}
			{date && <span class="showOnHover">{wpTime(date)}</span>}{' '}
			<span class="showOnHover"
				><a href={`#comment-${comment.id}`} title="Direkter Link zu diesem Kommentar">Direktlink</a></span
			>
		</cite>
	</p>
	<Fragment set:html={sanitizeComment(comment.content)} />
</li>

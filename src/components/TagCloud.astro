---
// tag-liste.php: Simple Tags st_tag_cloud(cloud_selection=count-desc, min_usage=2,
// smallest=90, largest=190, unit=%). Levels t0–t10 from the tag's share of the count
// range; colour fades from #000 (t10) to #ccc (t0), as in the original output.
import { getCollection } from 'astro:content';
import { tagSlug } from '../lib/slug';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const max = tags[0]?.[1] ?? 2;
const min = tags.at(-1)?.[1] ?? 2;
const level = (n: number) => (max === min ? 10 : Math.floor(((n - min) / (max - min)) * 10));
const gray = (l: number) => Math.floor((10 - l) * 20.4).toString(16).padStart(2, '0');
---

<h2>Alle flyingsparks-Tags:</h2>
<p>(Nur Tags, die mindestens 2x verwendet wurden.)</p>
<div class="st-tag-cloud">
	{
		tags.map(([t, n]) => {
			const l = level(n);
			return (
				<>
					<a
						href={`/tag/${tagSlug(t)}/`}
						class={`st-tags t${l}`}
						title={`${n} topics`}
						rel="tag"
						style={`font-size:${90 + 10 * l}%; color:#${gray(l).repeat(3)};`}
					>{t}</a>{' '}
				</>
			);
		})
	}
</div>

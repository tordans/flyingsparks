---
// Read-only comment archive of a post, like comments.php: one flat list in date
// order; pingbacks and trackbacks are numbered items of the same list.
// No submit form — new commenting is intentionally not offered.
import Comment from './Comment.astro';
import { getComments } from '../lib/wpComments';

interface Props {
	postId?: string;
}
const { postId } = Astro.props;
const all = [...getComments(postId)].sort(
	(a, b) => (a.date ?? '').localeCompare(b.date ?? '') || Number(a.id) - Number(b.id),
);
const heading = all.length === 1 ? 'ein Kommentar' : `${all.length} Kommentare`;
---

{
	all.length > 0 && (
		<div class="einPost" id="kommentare">
			<div id="commentarea" class="post-content inhaltsBox">
				<h2>
					{heading} <span />
				</h2>
				<div id="commentlist">
					<ol class="commentlist">
						{all.map((c, i) => (
							<Comment comment={c} odd={i % 2 === 0} />
						))}
					</ol>
				</div>
				<p class="nocomments">
					Die Kommentarfunktion ist geschlossen. Bestehende Kommentare bleiben als Archiv erhalten.
				</p>
			</div>
		</div>
	)
}

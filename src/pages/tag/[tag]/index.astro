---
// /tag/<tag>/ = page 1 of the posts with this tag.
import type { GetStaticPaths } from 'astro';
import PostList from '../../../components/PostList.astro';
import { getTaggedEntries, groupByTag, listPages, type ListPageProps } from '../../../lib/archive';

export const getStaticPaths = (async () =>
	groupByTag(await getTaggedEntries()).flatMap(({ slug, name, posts }) =>
		listPages(posts, { tag: slug }, 'first').map((p) => ({ ...p, props: { ...p.props, name } })),
	)) satisfies GetStaticPaths;

const { name, posts, paged, maxPage } = Astro.props as ListPageProps & { name: string };
---

<PostList
	title={`Thema: ${name}`}
	description={`Alle Funken zum Thema ${name}`}
	heading={`Alle Funken für das Thema <strong>${name.replace(/&/g, '&amp;')}</strong>:`}
	posts={posts}
	base={`/tag/${Astro.params.tag}/`}
	paged={paged}
	maxPage={maxPage}
/>

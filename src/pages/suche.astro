---
// Search results like search.php: the search form sits in the page heading.
// Client-side title search over the /funken.json index (title-only, lightweight).
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchForm from '../components/SearchForm.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={`Suche — ${SITE_TITLE}`} description="Beiträge durchsuchen" />
	</head>
	<body id="search" class="liste">
		<Header variant="search" />
		<div id="vorwort">
			<h2 id="dieUeberschrift">
				<SearchForm inputId="suche-input" />
			</h2>
		</div>
		<div class="einPost">
			<div class="post-content">
				<p id="suche-status"></p>
				<ul class="post-index" id="suche-results"></ul>
			</div>
		</div>
		<div class="einPostMeta"></div>
		<Sidebar />
		<Footer />

		<script>
			const params = new URLSearchParams(location.search);
			const q = (params.get('q') || '').trim();
			const status = document.getElementById('suche-status');
			const results = document.getElementById('suche-results');
			document.querySelectorAll<HTMLInputElement>('input[name="q"]').forEach((input) => {
				input.value = q;
			});

			if (q && status && results) {
				const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c] as string);
				fetch('/funken.json')
					.then((r) => r.json())
					.then((data: { t: string; u: string; d: number }[]) => {
						const needle = q.toLowerCase();
						const hits = data
							.filter((p) => p.t.toLowerCase().includes(needle))
							.sort((a, b) => b.d - a.d);
						status.textContent = `${hits.length} Treffer für „${q}“ (Titelsuche)`;
						results.innerHTML = hits
							.map((p) => {
								const dt = new Date(p.d).toLocaleDateString('de-DE', { year: 'numeric', month: 'short', day: 'numeric' });
								return `<li><a href="${p.u}">${esc(p.t)}</a><time>${dt}</time></li>`;
							})
							.join('');
					})
					.catch(() => { status.textContent = 'Suche derzeit nicht verfügbar.'; });
			} else if (status) {
				status.textContent = 'Gib ein Suchwort ein.';
			}
		</script>
	</body>
</html>

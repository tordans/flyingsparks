---
// Home page = page 1 of the post list (7 posts per page, newest first).
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../lib/archive';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { POSTS_PER_PAGE, pageCount } from '../lib/pagination';

const all = await getPublishedPosts();
const posts = all.slice(0, POSTS_PER_PAGE);
const maxPage = pageCount(all.length);
---

<PostList
	title={`${SITE_TITLE} — ${SITE_DESCRIPTION}`}
	description={SITE_DESCRIPTION}
	intro
	posts={posts}
	base="/"
	paged={1}
	maxPage={maxPage}
/>

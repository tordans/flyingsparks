---
// Themed 404 like 404.php + nicht-gefunden.php of the original theme
// (GitHub Pages serves /404.html automatically for unknown paths).
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchForm from '../components/SearchForm.astro';
import Sidebar from '../components/Sidebar.astro';
import Vorwort from '../components/Vorwort.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={`Nicht gefunden — ${SITE_TITLE}`} description="Seite nicht gefunden" />
	</head>
	<body id="nichtgefunden" class="einzeln">
		<Header variant="list" />
		<Vorwort />
		<div class="einPost postsingle" id="post">
			<h2 class="posttitel"><span>Die Seite konnte nicht gefunden werden // Fehler 404</span></h2>
			<div class="post-content">
				<div class="einPost">
					<div class="post-content">
						<p>Leider gibt es für diese Anfrage keine Einträge.</p>
						<p>Vielleicht findest du die gesuchte Seite über die Suchfunktion</p>
						<SearchForm inputId="s404" />
						oder über <a href="/themen-liste/">die Themen-Liste</a>.
						<p>Gut Pfad</p>
					</div>
				</div>
			</div>
		</div>
		<div class="einPostMeta" id="postMeta"></div>
		<Sidebar />
		<Footer />
	</body>
</html>

---
// single.php (posts), page.php (pages) and tag-liste.php (Themen-Liste) of the
// original theme.
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TagCloud from '../components/TagCloud.astro';
import Vorwort from '../components/Vorwort.astro';
import { SITE_TITLE } from '../consts';
import { tagSlug } from '../lib/slug';
import { titleHtml, titleText } from '../lib/title';
import { timeSince, wpDay, wpTime } from '../lib/wpDate';

type NavLink = { title: string; permalink: string };

interface Props {
	title: string;
	description?: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	wpPostId?: string;
	kind?: 'post' | 'page' | 'tags';
	prev?: NavLink;
	next?: NavLink;
	noindex?: boolean;
}
const {
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	wpPostId,
	kind = 'post',
	prev,
	next,
	noindex = false,
} = Astro.props;
const isPost = kind === 'post';
const bodyId = { post: 'single', page: 'page', tags: 'tags' }[kind];
const postId = `post${wpPostId ?? ''}`;
// 4× &nbsp; indent of the date lines in the meta column.
const indent = '    ';
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={`${titleText(title)} — ${SITE_TITLE}`} description={description ?? ''} noindex={noindex} />
	</head>
	<body id={bodyId} class="einzeln">
		<Header variant={isPost ? 'single' : 'list'} />

		<Vorwort />

		{
			isPost && (
				<div id="infoblock" class="einPost">
					<div class="seitennavigation">
						<div class="tr">
							<div class="seite erste">
								{prev && (
									<>
										&laquo; <a href={prev.permalink} rel="prev" set:html={titleHtml(prev.title)} />
									</>
								)}
							</div>
							<div class="seite letzte">
								{next && (
									<>
										<a href={next.permalink} rel="next" set:html={titleHtml(next.title)} /> &raquo;
									</>
								)}
							</div>
						</div>
					</div>
				</div>
			)
		}

		{
			kind === 'tags' ? (
				<div class="einPost liste suche" id="tagsuche">
					<div class="einPost postsingle" id={postId}>
						<h2 class="posttitel">
							<span set:html={titleHtml(title, { links: true })} />
						</h2>
						<div class="post-content">
							<slot />
							<TagCloud />
						</div>
					</div>
				</div>
			) : (
				<div class="einPost postsingle" id={postId}>
					<h2 class="posttitel">
						<span set:html={titleHtml(title, { links: true })} />
					</h2>
					<div class="post-content">
						<slot />
					</div>
				</div>
			)
		}

		<div class="einPostMeta" id={`${postId}Meta`}>
			{
				kind !== 'tags' && (
					<ul>
						{isPost && (
							<li>
								<span class="post-themen">
									&lowast; <strong>Themen:</strong>{' '}
									{tags.map((t, i) => (
										<>
											{i > 0 && ', '}
											<a href={`/tag/${tagSlug(t)}/`} rel="tag">{t}</a>
										</>
									))}
								</span>
							</li>
						)}
						<li>
							&lowast; <strong>Flugzeit:</strong> {timeSince(pubDate)}
						</li>
						<li>
							&lowast; <strong>abgehoben am:</strong> <br />
							{indent}
							<span title="Erstellungsdatum">
								{wpDay(pubDate)} &lowast; {wpTime(pubDate)}
							</span>
						</li>
						{updatedDate && updatedDate.getTime() !== pubDate.getTime() && (
							<li>
								&lowast; <strong>letzter Aufwind:</strong> <br />
								{indent}
								<span title="letzte Bearbeitung">
									{wpDay(updatedDate)} &lowast; {wpTime(updatedDate, true)}
								</span>
							</li>
						)}
					</ul>
				)
			}
		</div>

		<div class="clear"></div>

		{isPost && <Comments postId={wpPostId} />}

		<Sidebar nachOben={!isPost} />
		<Footer />
	</body>
</html>
